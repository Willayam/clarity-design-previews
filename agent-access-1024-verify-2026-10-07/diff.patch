diff --git a/editor/tests/agent-connections-api.test.ts b/editor/tests/agent-connections-api.test.ts
new file mode 100644
index 000000000..07cd1dc8d
--- /dev/null
+++ b/editor/tests/agent-connections-api.test.ts
@@ -0,0 +1,214 @@
+import { afterEach, beforeAll, beforeEach, describe, expect, test, vi } from "vitest"
+
+import frontendRouter from "../../workers/frontend-router/src/index"
+import { createAuthSessionCookie } from "../../workers/frontend-router/src/auth-session"
+import { AUTHKIT, callTool, CLAUDE_CODE, CODEX, configuredEnv, mint, ORIGIN, SECRET, signer, type Signer } from "./helpers/agent-door"
+
+// The owner's side under their own cookie: what the Settings screen (PR 5)
+// will call. Connections are created the real way, by a bearer call through
+// the door, and a revoke is proven by the door refusing the next token.
+
+let authkit: Signer
+type Env = ReturnType<typeof configuredEnv>
+type Connection = { id: string; clientId: string; status: string; leadsContacts: boolean; enabledAt: string | null; revokedAt: string | null; actions: unknown[] }
+
+const SAME_ORIGIN = { Origin: ORIGIN, "Sec-Fetch-Site": "same-origin" }
+
+const session = (workosUserId: string, impersonator?: { email: string; reason: string }) =>
+  createAuthSessionCookie({ impersonator, requestUrl: ORIGIN, secret: SECRET, workosUserId })
+
+async function api(env: Env, method: string, path: string, cookie: string | null, body?: unknown, headers: Record<string, string> = {}) {
+  const response = await frontendRouter.fetch(new Request(`${ORIGIN}${path}`, {
+    body: body === undefined ? undefined : JSON.stringify(body),
+    headers: {
+      ...(cookie ? { Cookie: cookie } : {}),
+      ...(method === "GET" ? {} : { "Content-Type": "application/json", ...SAME_ORIGIN }),
+      ...headers,
+    },
+    method,
+  }), env as never)
+  const text = await response.text()
+  return { body: text ? JSON.parse(text) as { data?: unknown; error?: string } : null, response, status: response.status }
+}
+
+const list = async (env: Env, cookie: string) => ((await api(env, "GET", "/api/agent/connections", cookie)).body!.data as { connections: Connection[] }).connections
+
+async function connect(env: Env, sub: string, clientId: string) {
+  const token = await mint(authkit, { clientId, sub })
+  const { response } = await callTool(env, token, "whoami")
+  return { status: response.status, token }
+}
+
+beforeAll(async () => {
+  authkit = await signer("authkit-1")
+})
+
+beforeEach(() => {
+  vi.stubGlobal("fetch", async (input: RequestInfo | URL) => {
+    const url = typeof input === "string" ? input : input instanceof URL ? input.href : input.url
+    if (url === `${AUTHKIT}/oauth2/jwks`) return Response.json(authkit.jwks)
+    return new Response("{}", { status: 502 })
+  })
+})
+
+afterEach(() => {
+  vi.unstubAllGlobals()
+})
+
+describe("GET /api/agent/connections", () => {
+  test("lists the owner's connections newest first with each one's last ten actions", async () => {
+    const env = configuredEnv()
+    await connect(env, "user_01GRANTED", CLAUDE_CODE)
+    await connect(env, "user_01GRANTED", CODEX)
+    await connect(env, "user_01AGENT", CLAUDE_CODE)
+    const [{ id: codex }] = env.AUTH_DB.query<{ id: string }>("SELECT id FROM agent_connections WHERE client_id = ? AND workos_user_id = 'user_01GRANTED'", CODEX)
+    for (let n = 1; n <= 12; n += 1) {
+      env.AUTH_DB.query(
+        "INSERT INTO agent_actions (id, connection_id, user_id, operation, effect, target_id, input_hash, outcome, result_json, created_at) VALUES (?, ?, 'auth-owner-granted', 'test_write', 'write', ?, 'h', 'ok', '{}', ?)",
+        `action-${n}`, codex, `page-${n}`, `2026-10-05T00:00:${String(n).padStart(2, "0")}.000Z`,
+      )
+    }
+    const connections = await list(env, await session("user_01GRANTED"))
+    expect(connections.map((connection) => [connection.clientId, connection.status, connection.leadsContacts, connection.actions.length])).toEqual([
+      [CODEX, "active", false, 10],
+      [CLAUDE_CODE, "active", false, 0],
+    ])
+    expect(connections[0].actions[0]).toEqual({
+      id: "action-12", operation: "test_write", effect: "write", targetId: "page-12", outcome: "ok", detail: null, createdAt: "2026-10-05T00:00:12.000Z",
+    })
+    expect((connections[0].actions as { id: string }[]).map((action) => action.id)).not.toContain("action-2")
+  })
+
+  test("a signed-out browser is refused", async () => {
+    expect((await api(configuredEnv(), "GET", "/api/agent/connections", null)).status).toBe(401)
+  })
+})
+
+describe("revoke, enable and the permission", () => {
+  test("revoke flips the row and the door refuses the client's next token; enable readmits it", async () => {
+    const env = configuredEnv()
+    const cookie = await session("user_01GRANTED")
+    await connect(env, "user_01GRANTED", CLAUDE_CODE)
+    const [{ id }] = await list(env, cookie)
+    const revoked = await api(env, "POST", `/api/agent/connections/${id}/revoke`, cookie)
+    expect([revoked.status, (revoked.body!.data as Connection).status]).toEqual([200, "revoked"])
+    expect(typeof (revoked.body!.data as Connection).revokedAt).toBe("string")
+    expect((await connect(env, "user_01GRANTED", CLAUDE_CODE)).status).toBe(403)
+
+    const enabled = await api(env, "POST", `/api/agent/connections/${id}/enable`, cookie)
+    expect([enabled.status, (enabled.body!.data as Connection).status]).toEqual([200, "active"])
+    expect((enabled.body!.data as Connection).revokedAt).toBe((revoked.body!.data as Connection).revokedAt)
+    expect((await connect(env, "user_01GRANTED", CLAUDE_CODE)).status).toBe(200)
+  })
+
+  test("after a revoke an unseen client lands pending, which the list shows and enable approves", async () => {
+    const env = configuredEnv()
+    const cookie = await session("user_01GRANTED")
+    await connect(env, "user_01GRANTED", CLAUDE_CODE)
+    const [{ id }] = await list(env, cookie)
+    await api(env, "POST", `/api/agent/connections/${id}/revoke`, cookie)
+    expect((await connect(env, "user_01GRANTED", CODEX)).status).toBe(403)
+    const pending = (await list(env, cookie)).find((connection) => connection.clientId === CODEX)!
+    expect([pending.status, pending.enabledAt]).toEqual(["pending", null])
+    const enabled = await api(env, "POST", `/api/agent/connections/${pending.id}/enable`, cookie)
+    expect((enabled.body!.data as Connection).status).toBe("active")
+    expect(typeof (enabled.body!.data as Connection).enabledAt).toBe("string")
+    expect((await connect(env, "user_01GRANTED", CODEX)).status).toBe(200)
+  })
+
+  test("re-enabling a revoked client is refused with 409 when it would exceed the live cap; approving a pending one is not", async () => {
+    const env = configuredEnv()
+    const cookie = await session("user_01GRANTED")
+    for (let n = 1; n <= 10; n += 1) await connect(env, "user_01GRANTED", `client_${n}`)
+    const a = (await list(env, cookie)).find((connection) => connection.clientId === "client_1")!
+    await api(env, "POST", `/api/agent/connections/${a.id}/revoke`, cookie)
+    expect((await connect(env, "user_01GRANTED", "client_b")).status).toBe(403)
+    const b = (await list(env, cookie)).find((connection) => connection.clientId === "client_b")!
+    expect(b.status).toBe("pending")
+
+    const refused = await api(env, "POST", `/api/agent/connections/${a.id}/enable`, cookie)
+    expect([refused.status, refused.body]).toEqual([409, {
+      code: "too_many_connections",
+      error: "This account already has 10 live agent connections; revoke one it no longer uses before re-enabling this one.",
+    }])
+    const approved = await api(env, "POST", `/api/agent/connections/${b.id}/enable`, cookie)
+    expect([approved.status, (approved.body!.data as Connection).status]).toEqual([200, "active"])
+    expect((await api(env, "POST", `/api/agent/connections/${b.id}/enable`, cookie)).status).toBe(200)
+    expect((await list(env, cookie)).filter((connection) => connection.status !== "revoked")).toHaveLength(10)
+
+    await api(env, "POST", `/api/agent/connections/${b.id}/revoke`, cookie)
+    const readmitted = await api(env, "POST", `/api/agent/connections/${a.id}/enable`, cookie)
+    expect([readmitted.status, (readmitted.body!.data as Connection).status]).toEqual([200, "active"])
+  })
+
+  test("PATCH grants leads_contacts, which the agent's next whoami reports; a non-boolean is 400", async () => {
+    const env = configuredEnv()
+    const cookie = await session("user_01GRANTED")
+    const { token } = await connect(env, "user_01GRANTED", CLAUDE_CODE)
+    const [{ id }] = await list(env, cookie)
+    const granted = await api(env, "PATCH", `/api/agent/connections/${id}`, cookie, { leadsContacts: true })
+    expect([granted.status, (granted.body!.data as Connection).leadsContacts]).toEqual([200, true])
+    expect((await callTool(env, token, "whoami")).tool).toMatchObject({ connection: { permissions: { leadsContacts: true } } })
+    expect((await api(env, "PATCH", `/api/agent/connections/${id}`, cookie, { leadsContacts: "yes" })).status).toBe(400)
+    expect((await api(env, "PATCH", `/api/agent/connections/${id}`, cookie)).status).toBe(400)
+  })
+
+  test("another owner's connection is not found for every write", async () => {
+    const env = configuredEnv()
+    await connect(env, "user_01AGENT", CLAUDE_CODE)
+    const [{ id }] = await list(env, await session("user_01AGENT"))
+    const stranger = await session("user_01GRANTED")
+    expect((await api(env, "POST", `/api/agent/connections/${id}/revoke`, stranger)).status).toBe(404)
+    expect((await api(env, "POST", `/api/agent/connections/${id}/enable`, stranger)).status).toBe(404)
+    expect((await api(env, "PATCH", `/api/agent/connections/${id}`, stranger, { leadsContacts: true })).status).toBe(404)
+    expect(env.AUTH_DB.query<{ status: string }>("SELECT status FROM agent_connections WHERE id = ?", id)[0].status).toBe("active")
+  })
+
+  test("an impersonated session may list and may not change anything", async () => {
+    const env = configuredEnv()
+    await connect(env, "user_01GRANTED", CLAUDE_CODE)
+    const support = await session("user_01GRANTED", { email: "support@clarity.video", reason: "ticket" })
+    const [{ id }] = await list(env, support)
+    for (const [method, path, body] of [
+      ["POST", `/api/agent/connections/${id}/revoke`, undefined],
+      ["POST", `/api/agent/connections/${id}/enable`, undefined],
+      ["PATCH", `/api/agent/connections/${id}`, { leadsContacts: true }],
+    ] as const) {
+      expect((await api(env, method, path, support, body)).status, `${method} ${path}`).toBe(403)
+    }
+    expect(env.AUTH_DB.query<{ status: string; leads_contacts: number }>("SELECT status, leads_contacts FROM agent_connections WHERE id = ?", id)[0]).toEqual({ leads_contacts: 0, status: "active" })
+  })
+
+  test("a walled owner can still revoke, and nothing else", async () => {
+    const env = configuredEnv()
+    const cookie = await session("user_01AGENT")
+    await connect(env, "user_01AGENT", CLAUDE_CODE)
+    const [{ id }] = await list(env, cookie)
+    expect((await api(env, "PATCH", `/api/agent/connections/${id}`, cookie, { leadsContacts: true })).status).toBe(402)
+    expect((await api(env, "POST", `/api/agent/connections/${id}/enable`, cookie)).status).toBe(402)
+    expect((await api(env, "POST", `/api/agent/connections/${id}/revoke`, cookie)).status).toBe(200)
+  })
+
+  test("a foreign-origin write is refused before the handler", async () => {
+    const env = configuredEnv()
+    const cookie = await session("user_01GRANTED")
+    await connect(env, "user_01GRANTED", CLAUDE_CODE)
+    const [{ id }] = await list(env, cookie)
+    const response = await api(env, "POST", `/api/agent/connections/${id}/revoke`, cookie, undefined, { Origin: "https://evil.example", "Sec-Fetch-Site": "cross-site" })
+    expect(response.status).toBe(403)
+    expect(env.AUTH_DB.query<{ status: string }>("SELECT status FROM agent_connections WHERE id = ?", id)[0].status).toBe("active")
+  })
+
+  test("a malformed percent escape in the id answers 400, not 500", async () => {
+    const env = configuredEnv()
+    const cookie = await session("user_01GRANTED")
+    expect((await api(env, "POST", "/api/agent/connections/%E0%A4%A/revoke", cookie)).status).toBe(400)
+    expect((await api(env, "PATCH", "/api/agent/connections/%zz", cookie, { leadsContacts: true })).status).toBe(400)
+  })
+
+  test("an unknown path under /api/agent answers 404 to a signed-in owner and 401 signed out", async () => {
+    const env = configuredEnv()
+    expect((await api(env, "GET", "/api/agent/nope", await session("user_01GRANTED"))).status).toBe(404)
+    expect((await api(env, "GET", "/api/agent/nope", null)).status).toBe(401)
+  })
+})
