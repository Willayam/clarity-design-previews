+import type { AuthAccountMappingDatabase } from '../../../../packages/auth-identity/src';
+import type { AgentActionsRow, AgentConnectionsRow } from '../../../../packages/d1-row-types/src';
+import { readJsonObjectRequest } from '../../../../packages/worker-request-body/src';
+import { resolveAuthSessionContext, type AuthSessionEnv } from '../auth-session';
+import { buildCorsHeaders, json, safeDecodeURIComponent } from '../router-http';
+import { connectionFromRow, MAX_CONNECTIONS_PER_USER, type AgentConnection } from './connections';
+
+// The owner's side of agent access, under their own cookie session: list the
+// connections with what each agent did lately, revoke, re-enable or approve
+// one, and grant or withdraw the leads_contacts permission. Support signed in
+// as the customer may look and never act, as with billing: every non-GET
+// refuses an impersonated session.
+
+const API_PREFIX = '/api/agent';
+const RECENT_ACTIONS = 10;
+const NO_STORE = { 'Cache-Control': 'no-store' };
+
+type ConnectionsEnv = AuthSessionEnv & { AUTH_DB?: AuthAccountMappingDatabase };
+
+type Session = NonNullable<Awaited<ReturnType<typeof resolveAuthSessionContext>>>;
+
+// The checks every path shares, served or not, so the -unrouted answer and
+// the handler's own 404 are the same response for the same caller.
+async function gate(request: Request, env: ConnectionsEnv): Promise<Session | Response> {
+  if (!env.AUTH_DB || !env.WORKOS_SESSION_COOKIE_SECRET) return json(request, { error: 'Agent connections are not configured' }, 503);
+  const session = await resolveAuthSessionContext(request, env);
+  if (!session) return json(request, { error: 'Unauthorized' }, 401);
+  if (session.impersonator && request.method !== 'GET') return json(request, { error: 'Forbidden' }, 403);
+  return session;
+}
+
+export async function answerUnroutedAgentRequest(request: Request, env: ConnectionsEnv): Promise<Response> {
+  if (request.method === 'OPTIONS') return new Response(null, { status: 204, headers: buildCorsHeaders(request, 'GET,POST,PATCH,OPTIONS') });
+  const gated = await gate(request, env);
+  return gated instanceof Response ? gated : json(request, { error: 'Not found' }, 404);
+}
+
+type RecentActionRow = Pick<AgentActionsRow, 'connection_id' | 'created_at' | 'detail' | 'effect' | 'id' | 'operation' | 'outcome' | 'target_id'>;
+
+type ConnectionView = AgentConnection & {
+  actions: { id: string; operation: string; effect: string; targetId: string | null; outcome: string; detail: string | null; createdAt: string }[];
+};
+
+async function listConnections(db: AuthAccountMappingDatabase, userId: string): Promise<ConnectionView[]> {
+  const [connections, actions] = await Promise.all([
+    db
+      .prepare(`
+        SELECT id, user_id, workos_user_id, client_id, client_name, status, leads_contacts, created_at, enabled_at, last_used_at, revoked_at
+        FROM agent_connections WHERE user_id = ? ORDER BY created_at DESC, id
+      `)
+      .bind(userId)
+      .all<AgentConnectionsRow>(),
+    db
+      .prepare(`
+        SELECT id, connection_id, operation, effect, target_id, outcome, detail, created_at FROM (
+          SELECT id, connection_id, operation, effect, target_id, outcome, detail, created_at,
+            ROW_NUMBER() OVER (PARTITION BY connection_id ORDER BY created_at DESC, rowid DESC) AS recency
+          FROM agent_actions WHERE user_id = ?
+        ) WHERE recency <= ? ORDER BY created_at DESC
+      `)
+      .bind(userId, RECENT_ACTIONS)
+      .all<RecentActionRow>(),
+  ]);
+  return (connections.results ?? []).map((row) => ({
+    ...connectionFromRow(row),
+    actions: (actions.results ?? [])
+      .filter((action) => action.connection_id === row.id)
+      .map((action) => ({
+        id: action.id,
+        operation: action.operation,
+        effect: action.effect,
+        targetId: action.target_id,
+        outcome: action.outcome,
+        detail: action.detail,
+        createdAt: action.created_at,
+      })),
+  }));
+}
+
+async function readOwned(db: AuthAccountMappingDatabase, userId: string, id: string): Promise<AgentConnection | null> {
+  const row = await db
+    .prepare(`
+      SELECT id, user_id, workos_user_id, client_id, client_name, status, leads_contacts, created_at, enabled_at, last_used_at, revoked_at
+      FROM agent_connections WHERE id = ? AND user_id = ? LIMIT 1
+    `)
+    .bind(id, userId)
+    .first<AgentConnectionsRow>();
+  return row ? connectionFromRow(row) : null;
+}
+
+// Each write is owner-scoped in its WHERE and idempotent: revoking a revoked
+// row or toggling a permission to its current value changes nothing and
+// answers the row as is.
+async function updateOwned(
+  request: Request,
+  db: AuthAccountMappingDatabase,
+  userId: string,
+  id: string,
+  set: string,
+  values: unknown[],
+): Promise<Response> {
+  await db.prepare(`UPDATE agent_connections SET ${set} WHERE id = ? AND user_id = ?`).bind(...values, id, userId).run();
+  const connection = await readOwned(db, userId, id);
+  return connection ? json(request, { data: connection }, 200, NO_STORE) : json(request, { error: 'Connection not found' }, 404);
+}
+
+// Re-enabling a revoked row adds a live connection, so it passes the same cap
+// admission does, inside the one UPDATE. Approving a pending row or enabling
+// an active one changes no live count and always goes through. Zero changes
+// on a row that is still revoked means the account is full.
+async function enableOwned(request: Request, db: AuthAccountMappingDatabase, userId: string, id: string, now: string): Promise<Response> {
+  await db
+    .prepare(`
+      UPDATE agent_connections SET status = 'active', enabled_at = ?
+      WHERE id = ? AND user_id = ?
+        AND (status <> 'revoked' OR (SELECT COUNT(*) FROM agent_connections WHERE user_id = ? AND status <> 'revoked') < ?)
+    `)
+    .bind(now, id, userId, userId, MAX_CONNECTIONS_PER_USER)
+    .run();
+  const connection = await readOwned(db, userId, id);
+  if (!connection) return json(request, { error: 'Connection not found' }, 404);
+  if (connection.status === 'revoked') {
+    return json(request, {
+      code: 'too_many_connections',
+      error: `This account already has ${MAX_CONNECTIONS_PER_USER} live agent connections; revoke one it no longer uses before re-enabling this one.`,
+    }, 409, NO_STORE);
+  }
+  return json(request, { data: connection }, 200, NO_STORE);
+}
+
+export async function handleAgentConnectionsApi(request: Request, env: ConnectionsEnv): Promise<Response> {
+  if (request.method === 'OPTIONS') return new Response(null, { status: 204, headers: buildCorsHeaders(request, 'GET,POST,PATCH,OPTIONS') });
+  const gated = await gate(request, env);
+  if (gated instanceof Response) return gated;
+  const db = env.AUTH_DB!;
+  const userId = gated.identity.userId;
+  const suffix = new URL(request.url).pathname.slice(API_PREFIX.length);
+  const now = new Date().toISOString();
+
+  if (suffix === '/connections') {
+    if (request.method !== 'GET') return json(request, { error: 'Method not allowed' }, 405);
+    return json(request, { data: { connections: await listConnections(db, userId) } }, 200, NO_STORE);
+  }
+
+  // A malformed percent escape in the id is the caller's fault, not a 500.
+  const connectionId = (segment: string) => safeDecodeURIComponent(segment) || null;
+
+  const revoke = suffix.match(/^\/connections\/([^/]+)\/revoke$/);
+  if (revoke) {
+    if (request.method !== 'POST') return json(request, { error: 'Method not allowed' }, 405);
+    const id = connectionId(revoke[1]);
+    if (!id) return json(request, { error: 'Connection id is malformed' }, 400);
+    return updateOwned(request, db, userId, id, `status = 'revoked', revoked_at = ?`, [now]);
+  }
+
+  // Approves a pending client or re-enables a revoked one; either way the
+  // owner said yes now, which enabled_at records.
+  const enable = suffix.match(/^\/connections\/([^/]+)\/enable$/);
+  if (enable) {
+    if (request.method !== 'POST') return json(request, { error: 'Method not allowed' }, 405);
+    const id = connectionId(enable[1]);
+    if (!id) return json(request, { error: 'Connection id is malformed' }, 400);
+    return enableOwned(request, db, userId, id, now);
+  }
+
+  const one = suffix.match(/^\/connections\/([^/]+)$/);
+  if (one) {
+    if (request.method !== 'PATCH') return json(request, { error: 'Method not allowed' }, 405);
+    const id = connectionId(one[1]);
+    if (!id) return json(request, { error: 'Connection id is malformed' }, 400);
+    const body = await readJsonObjectRequest(request, { empty: 'reject', maxBytes: 4_096 });
+    if (!body.ok) return json(request, { error: body.error.message }, body.error.status);
+    const leadsContacts = body.value.leadsContacts;
+    if (typeof leadsContacts !== 'boolean') return json(request, { error: 'leadsContacts must be true or false' }, 400);
+    return updateOwned(request, db, userId, id, 'leads_contacts = ?', [leadsContacts ? 1 : 0]);
+  }
+
+  return json(request, { error: 'Not found' }, 404);
+}
diff --git a/workers/frontend-router/src/agent/connections.ts b/workers/frontend-router/src/agent/connections.ts
new file mode 100644
index 000000000..d76f72f7e
--- /dev/null
+++ b/workers/frontend-router/src/agent/connections.ts
@@ -0,0 +1,136 @@
+import type { AuthAccountMappingDatabase } from '../../../../packages/auth-identity/src';
+import type { AgentConnectionsRow } from '../../../../packages/d1-row-types/src';
+
+// A connection is the row behind one (workos_user_id, client_id) pair for the
+// life of the account. Its status is the one switch the owner holds over an
+// agent client: active, pending the owner's approval, or revoked. A revoked
+// row refuses every token the pair presents, refreshed or not, which is what
+// WorkOS cannot do for an org-less user.
+export type AgentConnection = {
+  id: string;
+  userId: string;
+  workosUserId: string;
+  clientId: string;
+  clientName: string | null;
+  status: AgentConnectionsRow['status'];
+  leadsContacts: boolean;
+  createdAt: string;
+  enabledAt: string | null;
+  lastUsedAt: string | null;
+  revokedAt: string | null;
+};
+
+export type ConnectionRefusal = {
+  code: 'connection_revoked' | 'connection_pending' | 'too_many_connections';
+  message: string;
+  url: string;
+};
+
+export type ConnectionOutcome =
+  | { ok: true; connection: AgentConnection }
+  | { ok: false; refusal: ConnectionRefusal };
+
+export const MAX_CONNECTIONS_PER_USER = 10;
+// A call stamps last_used_at at most this often, so a chatty agent costs one
+// write a minute, not one per call.
+const LAST_USED_STAMP_MS = 60_000;
+
+export function settingsUrl(origin: string): string {
+  return `${origin}/settings/agents`;
+}
+
+export function connectionFromRow(row: AgentConnectionsRow): AgentConnection {
+  return {
+    clientId: row.client_id,
+    clientName: row.client_name,
+    createdAt: row.created_at,
+    enabledAt: row.enabled_at,
+    id: row.id,
+    lastUsedAt: row.last_used_at,
+    leadsContacts: row.leads_contacts === 1,
+    revokedAt: row.revoked_at,
+    status: row.status,
+    userId: row.user_id,
+    workosUserId: row.workos_user_id,
+  };
+}
+
+const CONNECTION_COLUMNS =
+  'id, user_id, workos_user_id, client_id, client_name, status, leads_contacts, created_at, enabled_at, last_used_at, revoked_at';
+
+async function findPair(db: AuthAccountMappingDatabase, workosUserId: string, clientId: string): Promise<AgentConnectionsRow | null> {
+  return db
+    .prepare(`SELECT ${CONNECTION_COLUMNS} FROM agent_connections WHERE workos_user_id = ? AND client_id = ? LIMIT 1`)
+    .bind(workosUserId, clientId)
+    .first<AgentConnectionsRow>();
+}
+
+// Admission is one guarded statement, so two first calls cannot both read nine
+// live rows and both insert, and a revoke cannot land between the count and
+// the insert. The cap counts live rows (active and pending): a revoked row
+// keeps its history but frees its slot. The status is chosen inside the same
+// statement from that history: once any row of the account carries
+// revoked_at, re-enabled or not, an unseen client waits for the owner. A
+// conflict on the pair inserts nothing, and so does a full account; the
+// caller tells them apart by reading the pair back.
+export const ADMIT_SQL = `
+  INSERT INTO agent_connections (id, user_id, workos_user_id, client_id, status, created_at, enabled_at)
+  SELECT ?1, ?2, ?3, ?4,
+    CASE WHEN EXISTS (SELECT 1 FROM agent_connections WHERE user_id = ?2 AND revoked_at IS NOT NULL) THEN 'pending' ELSE 'active' END,
+    ?5,
+    CASE WHEN EXISTS (SELECT 1 FROM agent_connections WHERE user_id = ?2 AND revoked_at IS NOT NULL) THEN NULL ELSE ?5 END
+  WHERE (SELECT COUNT(*) FROM agent_connections WHERE user_id = ?2 AND status <> 'revoked') < ?6
+  ON CONFLICT (workos_user_id, client_id) DO NOTHING
+`;
+
+async function admitPair(
+  db: AuthAccountMappingDatabase,
+  input: { userId: string; workosUserId: string; clientId: string; now: Date },
+): Promise<AgentConnectionsRow | 'too_many_connections'> {
+  await db
+    .prepare(ADMIT_SQL)
+    .bind(`conn_${crypto.randomUUID()}`, input.userId, input.workosUserId, input.clientId, input.now.toISOString(), MAX_CONNECTIONS_PER_USER)
+    .run();
+  const row = await findPair(db, input.workosUserId, input.clientId);
+  return row ?? 'too_many_connections';
+}
+
+async function stampLastUsed(db: AuthAccountMappingDatabase, row: AgentConnectionsRow, now: Date): Promise<AgentConnectionsRow> {
+  const stamp = now.toISOString();
+  const threshold = new Date(now.getTime() - LAST_USED_STAMP_MS).toISOString();
+  if (row.last_used_at !== null && row.last_used_at >= threshold) return row;
+  await db
+    .prepare('UPDATE agent_connections SET last_used_at = ? WHERE id = ? AND (last_used_at IS NULL OR last_used_at < ?)')
+    .bind(stamp, row.id, threshold)
+    .run();
+  return { ...row, last_used_at: stamp };
+}
+
+export async function resolveConnection(
+  db: AuthAccountMappingDatabase,
+  input: { userId: string; workosUserId: string; clientId: string; now: Date; origin: string },
+): Promise<ConnectionOutcome> {
+  const url = settingsUrl(input.origin);
+  const refuse = (code: ConnectionRefusal['code'], message: string): ConnectionOutcome => ({ ok: false, refusal: { code, message, url } });
+  let row = await findPair(db, input.workosUserId, input.clientId);
+  if (!row) {
+    const admitted = await admitPair(db, input);
+    if (admitted === 'too_many_connections') {
+      return refuse(
+        'too_many_connections',
+        `This account already has ${MAX_CONNECTIONS_PER_USER} live agent connections; in Settings, revoke one it no longer uses, or re-enable an existing one instead of adding a new client.`,
+      );
+    }
+    row = admitted;
+  }
+  switch (row.status) {
+    case 'revoked':
+      return refuse('connection_revoked', 'The account owner revoked this client in Settings.');
+    case 'pending':
+      return refuse('connection_pending', 'This client is waiting for the account owner to approve it in Settings.');
+    case 'active':
+      return { ok: true, connection: connectionFromRow(await stampLastUsed(db, row, input.now)) };
+    default:
+      throw new Error(`agent_connections.status ${String(row.status)} is outside the CHECK list`);
+  }
+}
diff --git a/workers/frontend-router/src/agent/dispatch.ts b/workers/frontend-router/src/agent/dispatch.ts
new file mode 100644
index 000000000..1807da08a
--- /dev/null
+++ b/workers/frontend-router/src/agent/dispatch.ts
@@ -0,0 +1,208 @@
+import type { AuthAccountMappingDatabase, WallCause } from '../../../../packages/auth-identity/src';
+import type { AgentActionsRow } from '../../../../packages/d1-row-types/src';
+import { reportUnexpectedError } from '../../../../packages/worker-sentry/src';
+import { withinRateLimit } from '../rate-limit';
+import { settingsUrl } from './connections';
+import type { Effect, Operation, OperationContext, Permission } from './operation';
+import { entitlementRequired, rateTierFor, readEntitlement } from './policy';
+
+// The policy dispatcher: every check one operation passes, in this order.
+//
+//   1. parse the input with the operation's schema         invalid_input
+//   2. the permission the operation requires                permission_required
+//   3. the second limiter, keyed per connection by effect   rate_limited
+//   4. entitlement, for write, spend and publish            access_walled, or 503
+//   5. replay, for a keyed non-read: an ok row with the     the stored result, or
+//      same key answers; a different input conflicts        idempotency_conflict
+//   6. run
+//   7. the audit row, for every non-read past the limiter
+//
+// Steps 1 to 5 of the design (cookie, signature, the per-user limiter,
+// identity, connection) live in caller.ts and answer with HTTP status. From
+// here on a refusal is a tool result the model can read, except that an
+// entitlement the router could not read answers 503: a bearer path never
+// fails open where the browser wall would.
+
+export type Refusal =
+  | { code: 'invalid_input'; issues: unknown }
+  | { code: 'permission_required'; permission: Permission; settingsUrl: string }
+  | { code: 'rate_limited'; retryAfterSeconds: number }
+  | { code: 'access_walled'; wallCause: WallCause }
+  | { code: 'idempotency_conflict' }
+  | { code: 'not_found'; message: string }
+  | { code: 'unavailable'; message: string };
+
+export type DispatchOutcome =
+  | { kind: 'result'; payload: Record<string, unknown> }
+  | { kind: 'refusal'; refusal: Refusal }
+  | { kind: 'entitlement_unavailable'; retryAfterSeconds: number };
+
+// An operation refuses by throwing this; the dispatcher turns it into a tool
+// result and, for a non-read, an audit row.
+export class OperationRefused extends Error {
+  constructor(readonly refusal: Refusal) {
+    super(refusal.code);
+  }
+}
+
+export function refuse(refusal: Refusal): never {
+  throw new OperationRefused(refusal);
+}
+
+const PERMISSION_FLAG: Record<Permission, keyof OperationContext['caller']['permissions']> = { leads_contacts: 'leadsContacts' };
+
+// JSON with keys sorted at every depth, so two agents sending the same input
+// in a different order hash alike.
+export function canonicalJson(value: unknown): string {
+  if (Array.isArray(value)) return `[${value.map(canonicalJson).join(',')}]`;
+  if (value && typeof value === 'object') {
+    const entries = Object.entries(value as Record<string, unknown>)
+      .filter(([, item]) => item !== undefined)
+      .sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0));
+    return `{${entries.map(([key, item]) => `${JSON.stringify(key)}:${canonicalJson(item)}`).join(',')}}`;
+  }
+  return JSON.stringify(value) ?? 'null';
+}
+
+async function sha256(text: string): Promise<string> {
+  const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
+  return Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, '0')).join('');
+}
+
+// `${operation}:${target}:${value}`, scoped so two operations, or two targets
+// at the same revision, never share a key.
+export function replayKey(operation: Operation, input: Record<string, unknown>, target: string | null): string | null {
+  const idempotency = operation.idempotency ?? { kind: 'none' };
+  if (idempotency.kind === 'none') return null;
+  const value = idempotency.kind === 'natural' ? input[idempotency.field] : input.idempotencyKey;
+  if (value === undefined || value === null || value === '') return null;
+  return `${operation.name}:${target ?? ''}:${String(value)}`;
+}
+
+type ReplayRow = Pick<AgentActionsRow, 'input_hash' | 'result_json'>;
+
+async function findReplay(db: AuthAccountMappingDatabase, connectionId: string, key: string): Promise<ReplayRow | null> {
+  return db
+    .prepare(`SELECT input_hash, result_json FROM agent_actions WHERE connection_id = ? AND idempotency_key = ? AND outcome = 'ok' LIMIT 1`)
+    .bind(connectionId, key)
+    .first<ReplayRow>();
+}
+
+type ActionRecord = {
+  effect: Exclude<Effect, 'read'>;
+  inputHash: string;
+  key: string | null;
+  operation: string;
+  target: string | null;
+} & (
+  | { outcome: 'ok'; resultJson: string }
+  | { outcome: 'refused' | 'failed'; detail: string }
+);
+
+// D1 names a violated constraint in the message (SQLITE_CONSTRAINT, or
+// node:sqlite's "UNIQUE constraint failed" in tests).
+function isConstraintViolation(error: unknown): boolean {
+  return error instanceof Error && /SQLITE_CONSTRAINT|constraint failed/i.test(error.message);
+}
+
+// The audit row lands after the effect, not in its batch, because the stores
+// own their batches. Its id is server-minted; the JSON-RPC id is 1 on every
+// connection's first call. A second ok row for the same key loses to the
+// replay index, which is the race between two identical concurrent calls;
+// the effect ran once per the operation's own idempotence and the first row
+// stands, so that one failure is reported and swallowed. Any other failure
+// surfaces: a write with no audit row must never read as a clean result.
+async function recordAction(context: OperationContext, action: ActionRecord): Promise<void> {
+  try {
+    await context.db
+      .prepare(`
+        INSERT INTO agent_actions (id, connection_id, user_id, operation, effect, target_id, idempotency_key, input_hash, outcome, result_json, detail, created_at)
+        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+      `)
+      .bind(
+        crypto.randomUUID(),
+        context.caller.connectionId,
+        context.caller.userId,
+        action.operation,
+        action.effect,
+        action.target,
+        action.key,
+        action.inputHash,
+        action.outcome,
+        action.outcome === 'ok' ? action.resultJson : null,
+        action.outcome === 'ok' ? null : action.detail,
+        context.now.toISOString(),
+      )
+      .run();
+  } catch (error) {
+    if (!(action.outcome === 'ok' && action.key !== null && isConstraintViolation(error))) throw error;
+    reportUnexpectedError(error);
+  }
+}
+
+export async function runOperation(operation: Operation, args: unknown, context: OperationContext): Promise<DispatchOutcome> {
+  const refusal = (value: Refusal): DispatchOutcome => ({ kind: 'refusal', refusal: value });
+  const parsed = operation.input.safeParse(args ?? {});
+  if (!parsed.success) return refusal({ code: 'invalid_input', issues: parsed.error.issues });
+  const input = parsed.data as Record<string, unknown>;
+
+  if (operation.requires && !context.caller.permissions[PERMISSION_FLAG[operation.requires]]) {
+    return refusal({ code: 'permission_required', permission: operation.requires, settingsUrl: settingsUrl(context.origin) });
+  }
+
+  const effect = operation.effect;
+  if (!(await withinRateLimit(context.env, rateTierFor(effect), `agent:${context.caller.connectionId}`))) {
+    return refusal({ code: 'rate_limited', retryAfterSeconds: 60 });
+  }
+
+  if (effect === 'read') {
+    try {
+      return { kind: 'result', payload: await operation.run(context, input) };
+    } catch (error) {
+      if (error instanceof OperationRefused) return refusal(error.refusal);
+      throw error;
+    }
+  }
+
+  const target = operation.target?.(input) ?? null;
+  const key = replayKey(operation, input, target);
+  const inputHash = await sha256(canonicalJson(input));
+  const record = { effect, inputHash, key, operation: operation.name, target } as const;
+  const refusedAndRecorded = async (value: Refusal): Promise<DispatchOutcome> => {
+    await recordAction(context, { ...record, detail: value.code, outcome: 'refused' });
+    return refusal(value);
+  };
+
+  if (entitlementRequired(effect)) {
+    let read;
+    try {
+      read = await readEntitlement(context.env, context.caller.connectionId, context.caller.ownerId, context.now);
+    } catch (error) {
+      reportUnexpectedError(error);
+      return { kind: 'entitlement_unavailable', retryAfterSeconds: 30 };
+    }
+    // D1 walled and Stripe silent: the browser wall would keep D1's verdict,
+    // a bearer path answers 503 and caches nothing.
+    if (read.kind === 'unavailable') return { kind: 'entitlement_unavailable', retryAfterSeconds: 30 };
+    if (read.offer.access === 'walled') return refusedAndRecorded({ code: 'access_walled', wallCause: read.offer.wallCause });
+  }
+
+  if (key) {
+    const replay = await findReplay(context.db, context.caller.connectionId, key);
+    if (replay) {
+      if (replay.input_hash !== inputHash) return refusedAndRecorded({ code: 'idempotency_conflict' });
+      return { kind: 'result', payload: JSON.parse(replay.result_json ?? '{}') as Record<string, unknown> };
+    }
+  }
+
+  let payload: Record<string, unknown>;
+  try {
+    payload = await operation.run(context, input);
+  } catch (error) {
+    if (error instanceof OperationRefused) return refusedAndRecorded(error.refusal);
+    await recordAction(context, { ...record, detail: error instanceof Error ? error.name : 'Error', outcome: 'failed' });
+    throw error;
+  }
+  await recordAction(context, { ...record, outcome: 'ok', resultJson: JSON.stringify(payload) });
+  return { kind: 'result', payload };
+}
diff --git a/workers/frontend-router/src/agent/mcp.ts b/workers/frontend-router/src/agent/mcp.ts
index 24bbb5537..cc1b05410 100644
--- a/workers/frontend-router/src/agent/mcp.ts
+++ b/workers/frontend-router/src/agent/mcp.ts
@@ -1,8 +1,11 @@
 import * as z from 'zod/mini';
 import { reportUnexpectedError } from '../../../../packages/worker-sentry/src';
 import { RATE_LIMITED_BODY, RETRY_AFTER_SECONDS } from '../rate-limit';
+import type { Env } from '../router-env';
 import { authenticateBearer, authorizationServers, type AgentEnv, type BearerRefusal } from './caller';
-import { OPERATIONS, toolsList, type OperationContext } from './registry';
