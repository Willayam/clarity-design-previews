@@ -0,0 +1,362 @@
+import { createHash } from "node:crypto"
+import { readdirSync, readFileSync } from "node:fs"
+import path from "node:path"
+import { afterEach, beforeAll, beforeEach, describe, expect, test, vi } from "vitest"
+import * as z from "zod/mini"
+
+import { defineOperation, type Operation } from "../../workers/frontend-router/src/agent/operation"
+import { OPERATIONS } from "../../workers/frontend-router/src/agent/registry"
+import { AUTHKIT, callTool, configuredEnv, mint, signer, type Signer } from "./helpers/agent-door"
+
+// The write-path machinery, proven over operations this test mounts, because
+// PR 2 ships reads only: the policy matrix, permissions, the second limiter,
+// the walled cache, the 503 on an entitlement the router could not read,
+// scoped replay, and the audit rows.
+
+const AGENT_DIR = path.resolve(import.meta.dirname, "../../workers/frontend-router/src/agent")
+
+let authkit: Signer
+const runs: Record<string, unknown>[] = []
+
+const noteWrite = defineOperation({
+  name: "test_note_write",
+  title: "Test write",
+  description: "A write keyed on the page revision.",
+  effect: "write",
+  destructiveHint: false,
+  idempotentHint: true,
+  input: z.object({ pageId: z.string(), revision: z.number(), text: z.string() }),
+  target: (input) => input.pageId,
+  idempotency: { kind: "natural", field: "revision" },
+  run: async (_context, input) => {
+    runs.push(input)
+    if (input.text === "boom") throw new Error("store down")
+    return { revision: input.revision, saved: true }
+  },
+})
+
+const noteRetract = defineOperation({
+  name: "test_note_retract",
+  title: "Test retract",
+  description: "A retract with no key.",
+  effect: "retract",
+  destructiveHint: true,
+  idempotentHint: true,
+  input: z.object({ pageId: z.string() }),
+  target: (input) => input.pageId,
+  run: async (_context, input) => {
+    runs.push(input)
+    return { retracted: true }
+  },
+})
+
+const noteSpend = defineOperation({
+  name: "test_note_spend",
+  title: "Test spend",
+  description: "A spend, on the strict tier.",
+  effect: "spend",
+  destructiveHint: false,
+  idempotentHint: false,
+  input: z.object({}),
+  run: async () => ({ spent: true }),
+})
+
+const leadsRead = defineOperation({
+  name: "test_leads_read",
+  title: "Test leads read",
+  description: "A read behind the leads_contacts permission.",
+  effect: "read",
+  destructiveHint: false,
+  idempotentHint: true,
+  requires: "leads_contacts",
+  input: z.object({}),
+  run: async () => ({ leads: [] }),
+})
+
+const MOUNTED: readonly Operation[] = [...OPERATIONS, noteWrite, noteRetract, noteSpend, leadsRead]
+
+type Env = ReturnType<typeof configuredEnv>
+type ActionRow = {
+  detail: string | null
+  effect: string
+  id: string
+  idempotency_key: string | null
+  input_hash: string
+  operation: string
+  outcome: string
+  result_json: string | null
+  target_id: string | null
+}
+
+const call = (env: Env, token: string, name: string, args: Record<string, unknown> = {}) => callTool(env, token, name, args, MOUNTED)
+
+const actions = (env: Env) =>
+  env.AUTH_DB.query<ActionRow>("SELECT id, operation, effect, target_id, idempotency_key, input_hash, outcome, result_json, detail FROM agent_actions ORDER BY rowid")
+
+// Counts the entitlement reads SQLite then runs as written.
+const entitlementReads = (env: Env) => {
+  const auth = env.AUTH_DB
+  let count = 0
+  const prepare = (sql: string) => {
+    // eslint-disable-next-line clarity/no-query-text-fakes -- the statement still runs; the text only identifies which read to count
+    if (sql.includes("AS grants_json")) count += 1
+    return auth.prepare(sql)
+  }
+  return { count: () => count, env: { ...env, AUTH_DB: { ...auth, prepare } } as Env }
+}
+
+beforeAll(async () => {
+  authkit = await signer("authkit-1")
+})
+
+beforeEach(() => {
+  runs.length = 0
+  vi.stubGlobal("fetch", async (input: RequestInfo | URL) => {
