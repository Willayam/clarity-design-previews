diff --git a/workers/frontend-router/src/agent/operation.ts b/workers/frontend-router/src/agent/operation.ts
new file mode 100644
index 000000000..9583eaf40
--- /dev/null
+++ b/workers/frontend-router/src/agent/operation.ts
@@ -0,0 +1,66 @@
+import * as z from 'zod/mini';
+import type { AuthAccountMappingDatabase } from '../../../../packages/auth-identity/src';
+import type { Env } from '../router-env';
+import type { AgentCaller } from './caller';
+import type { AgentConnection } from './connections';
+
+// What an operation does to what prospects can see. The dispatcher reads the
+// class to decide entitlement, the rate tier and, from PR 5, whether a human
+// must approve.
+//   read     open while walled, as browser GETs are; not audited
+//   write    entitlement; audited
+//   spend    write plus the daily generation cap
+//   publish  write plus human approval; changes what a public URL serves
+//   retract  reduces exposure; open while walled; audited
+//   destroy  human approval; irreversible; open while walled, as DELETE is
+export type Effect = 'read' | 'write' | 'spend' | 'publish' | 'retract' | 'destroy';
+
+// An extra the owner grants one connection in Settings; off by default.
+export type Permission = 'leads_contacts';
+
+// How a write is replayed. `natural` keys on one input field (a client key,
+// a revision); `input` keys on an optional idempotencyKey the agent sends;
+// `none` relies on the store's own compare-and-swap.
+export type Idempotency = { kind: 'natural'; field: string } | { kind: 'input' } | { kind: 'none' };
+
+export type OperationContext = {
+  caller: AgentCaller;
+  connection: AgentConnection;
+  db: AuthAccountMappingDatabase;
+  env: Env;
+  now: Date;
+  origin: string;
+  sleep: (ms: number) => Promise<void>;
+};
+
+export type Operation<Input extends z.ZodMiniObject = z.ZodMiniObject> = {
+  // Claude's tool pattern ^[a-zA-Z0-9_-]{1,64}$ forbids dots, so names use underscores.
+  name: string;
+  title: string;
+  // The first 512 characters stand alone: that is all some hosts show.
+  description: string;
+  effect: Effect;
+  destructiveHint: boolean;
+  idempotentHint: boolean;
+  requires?: Permission;
+  // The page id, video id or client key the call is about, for audit and replay keys.
+  target?: (input: z.output<Input>) => string | null;
+  idempotency?: Idempotency;
+  input: Input;
+  run: (context: OperationContext, input: z.output<Input>) => Promise<Record<string, unknown>>;
+};
+
+export const OPERATION_NAME = /^[a-z][a-z0-9_]{1,63}$/;
+
+// Prospect-typed and document text reaches the model wrapped, so a host can
+// tell what the owner wrote from what a stranger or an earlier run did.
+export type Untrusted<T> = { untrusted: true; source: 'prospect' | 'page'; value: T };
+
+export function untrusted<T>(source: Untrusted<T>['source'], value: T): Untrusted<T> {
+  return { source, untrusted: true, value };
+}
+
+// Erases the input type so operations over different schemas share one list.
+export function defineOperation<Input extends z.ZodMiniObject>(operation: Operation<Input>): Operation {
+  return operation as unknown as Operation;
+}
