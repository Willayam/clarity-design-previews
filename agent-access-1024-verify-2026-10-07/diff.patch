index 000000000..8d414232c
--- /dev/null
+++ b/workers/frontend-router/src/agent/policy.ts
@@ -0,0 +1,50 @@
+import type { RateLimitTier } from '../rate-limit';
+import { readWindowTrialOfferCheckingStripe, type EntitlementRead, type TrialOfferWithSyncEnv } from '../trial-offer-with-stripe-sync';
+import type { TrialOffer } from '../trial-offer-store';
+import type { Effect } from './operation';
+
+// What each effect class costs the account. Reads, retracts and destroys stay
+// open while walled, as the browser's GETs, unpublish and DELETE do
+// (trial-wall.ts isWallExit); writes, spends and publishes need entitlement.
+export function entitlementRequired(effect: Effect): boolean {
+  return effect === 'write' || effect === 'spend' || effect === 'publish';
+}
+
+// The second limiter, keyed per connection: strict (10/min) for the classes
+// that spend money or change what a prospect sees, standard (60/min) otherwise.
+// The standard tier here shares the per-user limiter's binding and allowance,
+// so with one connection it never trips first; it exists so a second client
+// of the same person gets its own counter, and so the strict tier has a
+// per-connection key to hang on. The design names both.
+export function rateTierFor(effect: Effect): RateLimitTier {
+  return effect === 'spend' || effect === 'publish' || effect === 'destroy' ? 'strict' : 'standard';
+}
+
+// A walled verdict is kept per connection for five minutes in the isolate, so
+// a retrying walled agent costs one Stripe-synced read, not sixty a minute. An
+// allowed verdict is never cached: the wall must bite as soon as D1 says so.
+const WALLED_VERDICT_MS = 5 * 60_000;
+const walledVerdicts = new Map<string, { until: number; offer: TrialOffer }>();
+
+export async function readEntitlement(
+  env: TrialOfferWithSyncEnv,
+  connectionId: string,
+  ownerId: string,
+  now: Date,
+): Promise<EntitlementRead> {
+  const at = now.getTime();
+  const cached = walledVerdicts.get(connectionId);
+  if (cached && cached.until > at) return { kind: 'offer', offer: cached.offer };
+  const read = await readWindowTrialOfferCheckingStripe(env, ownerId, now);
+  // An unavailable read is never cached: Stripe may answer on the next call.
+  if (read.kind === 'unavailable') return read;
+  if (read.offer.access === 'walled') {
+    if (walledVerdicts.size > 1_000) {
+      for (const [key, entry] of walledVerdicts) if (entry.until <= at) walledVerdicts.delete(key);
+    }
+    walledVerdicts.set(connectionId, { offer: read.offer, until: at + WALLED_VERDICT_MS });
+  } else {
+    walledVerdicts.delete(connectionId);
+  }
+  return read;
+}
