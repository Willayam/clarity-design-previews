new file mode 100644
index 000000000..a419b8e6d
--- /dev/null
+++ b/workers/frontend-router/migrations-auth/0042_agent_access.sql
@@ -0,0 +1,98 @@
+-- Agents reach Clarity through POST /mcp with an AuthKit bearer token (WIL-3245,
+-- Agent access 2). WorkOS holds the consent; these tables hold what WorkOS
+-- cannot for an org-less user: which client a person connected, whether they
+-- revoked, re-enabled or approved it here, which extra permissions they
+-- granted it, every write an agent made, and the human decisions behind the
+-- writes that publish or destroy.
+--
+-- agent_connections is one row per (workos_user_id, client_id) for the life of
+-- the account. A revoked row refuses every token, refreshed or not, until the
+-- owner re-enables it. Once a user has revoked anything, an unseen client lands
+-- pending and waits for the owner, because ChatGPT and Cursor mint a new client
+-- id per install. revoked_at is kept across a re-enable, so no CHECK ties it to
+-- status. WorkOS's own revocation is not relied on.
+--
+-- agent_actions is the audit log and the replay store. A replayed request finds
+-- its ok row by (connection_id, idempotency_key) and answers result_json
+-- unchanged; refused and failed rows are audit only and never block a retry,
+-- which is why the replay index is partial on outcome = 'ok'. Reads are not
+-- recorded. router.scheduled sweeps rows older than 90 days.
+--
+-- agent_approvals (read from PR 2, written from PR 5): pending -> executing
+-- (the owner's click claims the row) -> approved with result_json, or failed
+-- with detail. Expiry is read from expires_at; an expired pending row lapses
+-- lazily when the same request is asked again. One pending or executing row
+-- per (connection, operation, input_hash).
+--
+-- IF NOT EXISTS throughout: a stack deploy applies this about a minute before
+-- the router that reads it.
+
+CREATE TABLE IF NOT EXISTS agent_connections (
+  id TEXT PRIMARY KEY,
+  user_id TEXT NOT NULL REFERENCES users(id),
+  workos_user_id TEXT NOT NULL,
+  client_id TEXT NOT NULL,
+  client_name TEXT,
+  status TEXT NOT NULL CHECK (status IN ('active', 'pending', 'revoked')),
+  leads_contacts INTEGER NOT NULL DEFAULT 0 CHECK (leads_contacts IN (0, 1)),
+  created_at TEXT NOT NULL,
+  enabled_at TEXT,
+  last_used_at TEXT,
+  revoked_at TEXT
+);
+
+CREATE UNIQUE INDEX IF NOT EXISTS agent_connections_pair ON agent_connections (workos_user_id, client_id);
+CREATE INDEX IF NOT EXISTS agent_connections_user ON agent_connections (user_id, created_at);
+
+CREATE TABLE IF NOT EXISTS agent_actions (
+  id TEXT PRIMARY KEY,
+  connection_id TEXT NOT NULL REFERENCES agent_connections(id),
+  user_id TEXT NOT NULL REFERENCES users(id),
+  operation TEXT NOT NULL,
+  effect TEXT NOT NULL CHECK (effect IN ('write', 'spend', 'publish', 'retract', 'destroy')),
+  target_id TEXT,
+  idempotency_key TEXT,
+  input_hash TEXT NOT NULL,
+  outcome TEXT NOT NULL CHECK (outcome IN ('ok', 'refused', 'failed', 'approval_required')),
+  result_json TEXT,
+  detail TEXT,
+  approval_id TEXT,
+  created_at TEXT NOT NULL,
+  CHECK ((outcome = 'ok') = (result_json IS NOT NULL))
+);
+
+CREATE UNIQUE INDEX IF NOT EXISTS agent_actions_replay
+  ON agent_actions (connection_id, idempotency_key) WHERE idempotency_key IS NOT NULL AND outcome = 'ok';
+CREATE INDEX IF NOT EXISTS agent_actions_user ON agent_actions (user_id, created_at);
+CREATE INDEX IF NOT EXISTS agent_actions_connection ON agent_actions (connection_id, created_at);
+-- The 90-day sweep deletes by created_at alone.
+CREATE INDEX IF NOT EXISTS agent_actions_created ON agent_actions (created_at);
+
+CREATE TABLE IF NOT EXISTS agent_approvals (
+  id TEXT PRIMARY KEY,
+  connection_id TEXT NOT NULL REFERENCES agent_connections(id),
+  user_id TEXT NOT NULL REFERENCES users(id),
+  operation TEXT NOT NULL,
+  target_id TEXT NOT NULL,
+  input_json TEXT NOT NULL,
+  input_hash TEXT NOT NULL,
+  facts_digest TEXT NOT NULL,
+  status TEXT NOT NULL CHECK (status IN ('pending', 'executing', 'approved', 'denied', 'failed', 'lapsed')),
+  result_json TEXT,
+  detail TEXT,
+  created_at TEXT NOT NULL,
+  expires_at TEXT NOT NULL,
+  claimed_at TEXT,
+  decided_at TEXT,
+  CHECK ((status = 'pending') = (claimed_at IS NULL AND decided_at IS NULL)),
+  CHECK (status <> 'executing' OR (claimed_at IS NOT NULL AND decided_at IS NULL)),
+  CHECK ((status IN ('approved', 'denied', 'failed', 'lapsed')) = (decided_at IS NOT NULL)),
+  CHECK (status <> 'approved' OR result_json IS NOT NULL)
+);
+
+CREATE UNIQUE INDEX IF NOT EXISTS agent_approvals_pending
+  ON agent_approvals (connection_id, operation, input_hash) WHERE status IN ('pending', 'executing');
+CREATE INDEX IF NOT EXISTS agent_approvals_user ON agent_approvals (user_id, status, created_at);
+
+-- The daily generation cap (PR 4) counts a workspace's jobs since midnight UTC.
+CREATE INDEX IF NOT EXISTS jobs_by_workspace_created ON jobs (kind, workspace_id, created_at);
