@@ -0,0 +1,29 @@
+import { expect, test } from "vitest"
+
+import { sweepAgentActions } from "../../workers/frontend-router/src/agent/sweep"
+import { createSqliteAuthDb, seedAccount } from "./helpers/sqlite-auth-db"
+
+const NOW = Date.parse("2026-10-06T12:00:00.000Z")
+const DAY = 86_400_000
+
+test("the sweep deletes agent actions older than 90 days and nothing newer", async () => {
+  const db = createSqliteAuthDb()
+  seedAccount(db, { ownerId: "owner", workosUserId: "user_01OWNER" })
+  db.query("INSERT INTO agent_connections (id, user_id, workos_user_id, client_id, status, created_at) VALUES ('conn_1', 'auth-owner', 'user_01OWNER', 'client_1', 'active', ?)", new Date(NOW - 100 * DAY).toISOString())
+  const action = (id: string, ageDays: number) => db.query(
+    "INSERT INTO agent_actions (id, connection_id, user_id, operation, effect, input_hash, outcome, result_json, created_at) VALUES (?, 'conn_1', 'auth-owner', 'test_write', 'write', 'h', 'ok', '{}', ?)",
+    id, new Date(NOW - ageDays * DAY).toISOString(),
+  )
+  action("old", 91)
+  action("edge", 90)
+  action("recent", 89)
+  action("today", 0)
+
+  expect(await sweepAgentActions({ AUTH_DB: db }, NOW)).toBe(1)
+  expect(db.query<{ id: string }>("SELECT id FROM agent_actions ORDER BY created_at").map((row) => row.id)).toEqual(["edge", "recent", "today"])
+  expect(await sweepAgentActions({ AUTH_DB: db }, NOW)).toBe(0)
+})
+
+test("without a database the sweep does nothing", async () => {
+  expect(await sweepAgentActions({}, NOW)).toBe(0)
+})
