+import type { AuthAccountMappingDatabase } from '../../../../packages/auth-identity/src';
+
+// The audit log is also the replay store, and a replay a quarter old serves no
+// one: an agent that retries after 90 days is making a new request. The cron
+// runs this once a minute; previews run no cron and keep every row.
+export const AGENT_ACTIONS_RETENTION_DAYS = 90;
+
+export async function sweepAgentActions(env: { AUTH_DB?: AuthAccountMappingDatabase }, now: number): Promise<number> {
+  if (!env.AUTH_DB) return 0;
+  const cutoff = new Date(now - AGENT_ACTIONS_RETENTION_DAYS * 86_400_000).toISOString();
+  const result = await env.AUTH_DB.prepare('DELETE FROM agent_actions WHERE created_at < ?').bind(cutoff).run();
+  return result.meta?.changes ?? 0;
+}
