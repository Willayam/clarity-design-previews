index 000000000..4ed957dfd
--- /dev/null
+++ b/editor/tests/helpers/agent-door.ts
@@ -0,0 +1,92 @@
+// The agent door's test scaffolding: an RS256 signer standing in for AuthKit,
+// a token minter with the claims every host's token carries, and a router env
+// with three seeded accounts (walled, granted, suspended) on a real SQLite
+// AUTH_DB. Shared by the door test and the dispatcher test.
+import { exportJWK, generateKeyPair, SignJWT, type CryptoKey, type JSONWebKeySet } from "jose"
+
+import { handleMcpRequest } from "../../../workers/frontend-router/src/agent/mcp"
+import type { Operation } from "../../../workers/frontend-router/src/agent/operation"
+import { createSqliteAuthDb, seedAccount, seedGrant, suspendAccount } from "./sqlite-auth-db"
+
+export const ORIGIN = "https://clarity.video"
+export const PREVIEW_ORIGIN = "https://pr-912.clarity-video.workers.dev"
+export const AUTHKIT = "https://authkit.example"
+export const SECRET = "agent-door-session-secret"
+
+export type Signer = { jwks: JSONWebKeySet; kid: string; privateKey: CryptoKey }
+
+export async function signer(kid: string): Promise<Signer> {
+  const { privateKey, publicKey } = await generateKeyPair("RS256", { extractable: true })
+  return { jwks: { keys: [{ ...await exportJWK(publicKey), alg: "RS256", kid, use: "sig" }] }, kid, privateKey }
+}
+
+export const CLAUDE_CODE = "https://claude.ai/oauth/claude-code-client-metadata"
+export const CODEX = "https://chatgpt.com/oauth/codex/BCUHP4jQVaRK/client.json"
+
+export type Claims = {
+  act?: Record<string, string>
+  aud?: string
+  clientId?: string | null
+  exp?: number
+  iss?: string
+  scope?: string | null
+  sub?: string
+}
+
+export async function mint(by: Signer, claims: Claims = {}): Promise<string> {
+  const now = Math.floor(Date.now() / 1000)
+  const payload: Record<string, unknown> = {}
+  if (claims.scope !== null) payload.scope = claims.scope ?? "openid profile email offline_access"
+  if (claims.clientId !== null) payload.client_id = claims.clientId ?? CLAUDE_CODE
+  if (claims.act) payload.act = claims.act
+  return new SignJWT(payload)
+    .setProtectedHeader({ alg: "RS256", kid: by.kid })
+    .setIssuer(claims.iss ?? AUTHKIT)
+    .setAudience(claims.aud ?? `${ORIGIN}/mcp`)
+    .setSubject(claims.sub ?? "user_01AGENT")
+    .setIssuedAt(now - 60)
+    .setExpirationTime(claims.exp ?? now + 600)
+    .sign(by.privateKey)
+}
+
+export function configuredEnv(extra: Record<string, unknown> = {}) {
+  const auth = createSqliteAuthDb()
+  seedAccount(auth, { ownerId: "owner-walled", workosUserId: "user_01AGENT" })
+  seedAccount(auth, { ownerId: "owner-granted", workosUserId: "user_01GRANTED" })
+  seedGrant(auth, { endsAt: "2999-01-01T00:00:00.000Z", kind: "complimentary", ownerId: "owner-granted" })
+  seedAccount(auth, { ownerId: "owner-held", workosUserId: "user_01HELD" })
+  suspendAccount(auth, "owner-held")
+  return {
+    ASSETS: { fetch: async () => new Response("asset") },
+    AGENT_AUTH_ISSUER: AUTHKIT,
+    AUTH_DB: auth,
+    AUTH_LOOKUP_RATE_LIMITER: { limit: async () => ({ success: true }) },
+    WORKOS_SESSION_COOKIE_SECRET: SECRET,
+    ...extra,
+  }
+}
+
+export type ToolAnswer = {
+  body: { result?: { isError?: boolean; structuredContent: Record<string, unknown> }; error?: { code: number; message: string }; code?: string }
+  response: Response
+  /** The tool result or refusal, null when the answer was no tool result. */
+  tool: Record<string, unknown> | null
+}
+
+// One tools/call through the door, with the registry or a list a test mounts.
+export async function callTool(
+  env: Record<string, unknown>,
+  token: string,
+  name: string,
+  args: Record<string, unknown> = {},
+  operations?: readonly Operation[],
+): Promise<ToolAnswer> {
+  const request = new Request(`${ORIGIN}/mcp`, {
+    body: JSON.stringify({ jsonrpc: "2.0", id: 1, method: "tools/call", params: { name, arguments: args } }),
+    headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
+    method: "POST",
+  })
+  const response = await handleMcpRequest(request, new URL(request.url), env as never, operations)
+  const body = await response.json() as ToolAnswer["body"]
+  return { body, response, tool: body.result?.structuredContent ?? null }
+}
