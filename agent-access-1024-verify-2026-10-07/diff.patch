+  for (const file of readdirSync(STATS_MIGRATIONS).sort()) if (file.endsWith(".sql")) sqlite.exec(readFileSync(path.join(STATS_MIGRATIONS, file), "utf8"))
+  const values = (list: unknown[]) => list.map((value) => (value === undefined ? null : value)) as never[]
+  return {
+    sqlite,
+    batch: async () => [],
+    prepare: (sql: string) => ({
+      bind: (...bound: unknown[]) => ({
+        all: async <T>() => ({ results: sqlite.prepare(sql).all(...values(bound)) as T[] }),
+        first: async <T>() => (sqlite.prepare(sql).get(...values(bound)) as T) ?? null,
