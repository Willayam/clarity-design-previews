diff --git a/workers/frontend-router/src/agent/ops-videos.ts b/workers/frontend-router/src/agent/ops-videos.ts
new file mode 100644
index 000000000..5222f4821
--- /dev/null
+++ b/workers/frontend-router/src/agent/ops-videos.ts
@@ -0,0 +1,127 @@
+import * as z from 'zod/mini';
+import type { VideosRow } from '../../../../packages/d1-row-types/src';
+import { resolvePlayback } from '../../../../packages/served-file-policy/src';
+import { libraryUser } from './caller';
+import { refuse } from './dispatch';
+import { defineOperation, type OperationContext } from './operation';
+
+export type VideoView = {
+  videoId: string;
+  title: string;
+  state: 'uploading' | 'processing' | 'ready' | 'failed';
+  shareLinkLive: boolean;
+  clipPending: boolean;
+  durationSeconds?: number;
+  playbackUrl?: string;
+  posterUrl?: string;
+  folderId: string | null;
+};
+
+type VideoNode = {
+  assetId: string | null;
+  id: string;
+  metadata: unknown;
+  name: string;
+  parentId: string | null;
+  readiness?: { pending: readonly string[]; shareLinkLive: boolean; state: 'preparing' | 'ready' | 'degraded' | 'recovery_required' } | null;
+};
+
+type DeliveryRow = Pick<VideosRow, 'delivery' | 'duration_seconds'>;
+
+const POLL_MS = 10_000;
+const MAX_WAIT_SECONDS = 45;
+
+// The videos row is the one source of the delivery state (WIL-3494); a node
+// with no row is a legacy video whose node metadata still says what plays.
+function stateOf(node: VideoNode, row: DeliveryRow | null): VideoView['state'] {
+  switch (row?.delivery) {
+    case 'uploading':
+    case 'processing':
+    case 'ready':
+      return row.delivery;
+    case 'failed':
+    case 'stalled':
+      return 'failed';
+    case undefined:
+  }
+  switch (node.readiness?.state) {
+    case 'preparing':
+      return 'processing';
+    case 'recovery_required':
+      return 'failed';
+    default:
+      return 'ready';
+  }
+}
+
+export function videoView(videoId: string, node: VideoNode, row: DeliveryRow | null): VideoView {
+  const metadata = node.metadata && typeof node.metadata === 'object' && !Array.isArray(node.metadata) ? node.metadata as Record<string, unknown> : {};
+  const playback = resolvePlayback(metadata);
+  const duration = row?.duration_seconds ?? (typeof metadata.duration === 'number' && Number.isFinite(metadata.duration) ? metadata.duration : null);
+  return {
+    videoId: node.assetId ?? videoId,
+    title: node.name,
+    state: stateOf(node, row),
+    shareLinkLive: node.readiness?.shareLinkLive ?? playback.tier === 'mux',
+    clipPending: node.readiness?.pending.includes('clip') ?? false,
+    ...(duration !== null ? { durationSeconds: duration } : {}),
+    ...(playback.muxPlaybackId ? { playbackUrl: `https://stream.mux.com/${playback.muxPlaybackId}.m3u8` } : {}),
+    ...(playback.posterUrl ? { posterUrl: playback.posterUrl } : {}),
+    folderId: node.parentId,
+  };
+}
+
+// assetNode settles against Mux on read, so it is called on the first and the
+// last poll only; the polls between read the videos row from D1.
+async function settledNode(context: OperationContext, videoId: string): Promise<VideoNode> {
+  const library = context.env.LIBRARY;
+  if (!library) refuse({ code: 'unavailable', message: 'The Library is not configured on this host.' });
+  const response = await library.assetNode(libraryUser(context.caller), videoId);
+  if (response.status === 404) refuse({ code: 'not_found', message: 'No video with this id is in your Library.' });
+  if (!response.ok) refuse({ code: 'unavailable', message: `The Library answered ${response.status}.` });
+  const { data } = await response.json() as { data: { node: VideoNode } };
+  return data.node;
+}
+
+async function deliveryRow(context: OperationContext, nodeId: string): Promise<DeliveryRow | null> {
+  const db = context.env.PAGE_LIBRARY_DB;
+  if (!db) return null;
+  return db
+    .prepare('SELECT delivery, duration_seconds FROM videos WHERE node_id = ? AND workspace_id = ? LIMIT 1')
+    .bind(nodeId, context.caller.workspaceId)
+    .first<DeliveryRow>();
+}
+
+const settled = (state: VideoView['state']) => state === 'ready' || state === 'failed';
+
+export const videosGet = defineOperation({
+  name: 'videos_get',
+  title: 'Get a video',
+  description:
+    'Read one video by id: title, state (uploading, processing, ready or failed), whether its share link is live, ' +
+    'whether a trimmed clip is still rendering, duration, playback and poster URLs, and its folder. waitSeconds ' +
+    '(0 to 45) keeps the call open until the video is ready or failed, polling every 10 seconds, for a video that ' +
+    'is still processing.',
+  effect: 'read',
+  destructiveHint: false,
+  idempotentHint: true,
+  input: z.object({
+    videoId: z.string().check(z.minLength(1), z.maxLength(128)),
+    waitSeconds: z.optional(z.int().check(z.gte(0), z.lte(MAX_WAIT_SECONDS))),
+  }),
+  run: async (context, input) => {
+    let node = await settledNode(context, input.videoId);
+    let row = await deliveryRow(context, node.id);
+    const waitMs = (input.waitSeconds ?? 0) * 1000;
+    if (waitMs > 0 && !settled(stateOf(node, row))) {
+      for (let waited = 0; waited < waitMs; waited += POLL_MS) {
+        await context.sleep(Math.min(POLL_MS, waitMs - waited));
+        row = await deliveryRow(context, node.id);
+        if (row && settled(stateOf(node, row))) break;
+      }
+      node = await settledNode(context, input.videoId);
+      row = await deliveryRow(context, node.id);
+    }
+    return videoView(input.videoId, node, row);
+  },
+});
